{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "용병 일기 실행",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONUTF8": "1" },
      "justMyCode": true
    }
  ]
}
