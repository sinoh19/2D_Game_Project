{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python 환경 설치",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/setup.ps1"],
      "problemMatcher": []
    },
    {
      "label": "게임 실행",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-X", "utf8", "${workspaceFolder}/main.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
